// Zed debug configurations (house standard project-dev-surfaces). Secrets
// come from the environment Zed was started in, never from this file.
[
  // house:managed:begin - synced from Resnovas/.github templates/.zed/debug.json. Edits inside this block are overwritten.
  {
    "label": "Node: current file",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Surfaces: install (dry run)",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/tools/dev/surfaces.mjs",
    "args": ["install", "--dry-run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
  // house:managed:end
  // house:local - add this repository's own debug configurations below this line.
  {
    "label": "Render: templates into this repo",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/scripts/render.mjs",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Render: preview a downstream repo",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/scripts/render.mjs",
    "args": ["--out", ".render-preview", "--repository", "Resnovas/example"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Test: all",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeArgs": ["--test", "test/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Test: current file",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeArgs": ["--test"],
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "skipFiles": ["<node_internals>/**"],
  },
]
