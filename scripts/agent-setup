#!/bin/sh
# Sets up the locked lint toolchain and repository surfaces. Idempotent.
# Windows: run npm ci --ignore-scripts, then the node commands below.
set -eu
cd "$(dirname "$0")/.."
supported=$(node -p 'const [major, minor] = process.versions.node.split(".").map(Number); major > 24 || (major === 24 && minor >= 15)' 2>/dev/null || echo false)
if [ "$supported" != true ]; then
  echo "agent-setup: Node 24.15 or newer is required. Install it (nvm, fnm or nodejs.org) and run again." >&2
  exit 1
fi
npm ci --ignore-scripts
node --run setup
node --run verify:static
node --run check
echo "agent-setup: ok"
