{
  "mcpServers": {
    "mem0-gateway": {
      "type": "http",
      "url": "https://gateway-mcp.mem0.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${MEM0_GATEWAY_TOKEN:-}"
      }
    },
    "cognee": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "cognee-mcp@latest"
      ],
      "env": {
        "COGNEE_BASE_URL": "${COGNEE_BASE_URL:-}",
        "COGNEE_API_KEY": "${COGNEE_API_KEY:-}"
      }
    },
    "graphify": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "tools/graphify/graphify",
        "mcp"
      ]
    },
    "graphify-cloud": {
      "type": "http",
      "url": "https://api.graphify.com/mcp"
    }
  }
}
